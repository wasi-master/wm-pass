<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only used by features the owner turns on: sync, breach checks, aliases. See NetPolicy. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Asked for only when scanning a QR code or a card. The camera is optional: both can be typed. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Hardware keys, optional. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- The apps a launcher shows, so a login can be tied to one from a list. Nothing about them is sent anywhere. -->
    <queries>
        <!-- WM Keyboard, so its fill setting can start on when it is installed. -->
        <package android:name="com.wasimaster.wmkeyboard" />
        <package android:name="com.wasimaster.wmkeyboard.debug" />
        <package android:name="com.wasimaster.wmkeyboard.fast" />
        <!-- Shizuku, to say whether it needs installing or only starting. -->
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- allowBackup off: a vault leaves this phone only by the owner's hand. -->
    <application
        android:enableOnBackInvokedCallback="true"
        android:name=".app.PassApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_extraction"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="WM Pass"
        android:supportsRtl="true"
        android:theme="@style/Theme.WmPass"
        tools:targetApi="36">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:label="Save to WM Pass">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="Keep in WM Pass">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="otpauth" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Where a Dropbox, OneDrive, Box or Google Drive sign-in in the browser comes back. -->
        <activity
            android:name=".system.OAuthRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wmpass" android:host="oauth" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${driveScheme}" />
            </intent-filter>
        </activity>

        <!-- WM Keyboard's "Use a place from WM Pass". It answers only WM Keyboard, by certificate. -->
        <activity
            android:name=".system.PlaceShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".system.AutofillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".system.PassAutofillService"
            android:exported="true"
            android:label="WM Pass"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>

        <activity
            android:name=".system.PasskeyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".system.PasskeyService"
            android:enabled="@bool/passkeys_supported"
            android:exported="true"
            android:label="WM Pass"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data android:name="android.credentials.provider" android:resource="@xml/credentials_provider" />
        </service>

        <service
            android:name=".system.LockTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_lock"
            android:label="@string/tile_lock"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".system.PanicTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_panic"
            android:label="@string/tile_panic"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".system.PanicActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="info.guardianproject.panic.action.TRIGGER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Every call checks the caller's signing certificate. See KeyboardProvider. -->
        <provider
            android:name=".system.KeyboardProvider"
            android:authorities="com.wasimaster.wmpass.keyboard"
            android:exported="true" />

        <!-- Home screen widgets. The quick bar keeps its old class name, so widgets already placed stay. -->
        <receiver
            android:name=".system.QuickWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/quick_widget" />
        </receiver>
        <receiver
            android:name=".system.widgets.StatusWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_status">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/status_widget" />
        </receiver>
        <receiver
            android:name=".system.widgets.HealthWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_health">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/health_widget" />
        </receiver>
        <receiver
            android:name=".system.widgets.BackupsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_backups">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/backups_widget" />
        </receiver>
        <receiver
            android:name=".system.widgets.GeneratorWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_generator">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/generator_widget" />
        </receiver>
        <receiver
            android:name=".system.widgets.CodesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_codes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/codes_widget" />
        </receiver>
        <receiver
            android:name=".system.widgets.FavoritesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_favorites">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/favorites_widget" />
        </receiver>
        <!-- Redraws widgets locked if the process died while they showed codes. Only this app's alarm sends it. -->
        <receiver
            android:name=".system.widgets.WidgetBlankReceiver"
            android:exported="false" />
        <!-- Where Shizuku hands over its binder. Only the system may call it. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
