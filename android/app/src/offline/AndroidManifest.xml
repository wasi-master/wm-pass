<?xml version="1.0" encoding="utf-8"?>
<!--
    The offline build: the main manifest with the network taken out, merged over it rather than in
    place of it, so every screen, service and receiver the app has is there in this build too.
    "remove" also strips the permission when a library's own manifest asks for it, which a copy of
    the main manifest without the line did not.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <application>
        <!-- No cloud sign-in in this build, so nothing comes back to it from a browser. -->
        <activity android:name=".system.OAuthRedirectActivity" tools:node="remove" />
    </application>
</manifest>
