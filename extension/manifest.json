{
  "manifest_version": 3,
  "name": "WM Pass",
  "version": "0.1.0",
  "description": "Fills your logins from a vault on this device, or from the WM Pass app.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "WM Pass" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms", "idle", "offscreen", "clipboardWrite", "nativeMessaging", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" } } },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" },
    { "matches": ["https://*/*"], "js": ["page-world.js"], "all_frames": true, "run_at": "document_start", "world": "MAIN" }
  ],
  "web_accessible_resources": []
}
