{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WM Pass",
  "version": "0.1.0",
  "identifier": "com.wasimaster.wmpass.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5184",
    "beforeDevCommand": "node ../scripts/build-host.mjs && npm run desktop:dev",
    "beforeBuildCommand": "node ../scripts/build-host.mjs && npm run desktop:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WM Pass",
        "url": "index.html",
        "width": 1120,
        "height": 740,
        "minWidth": 420,
        "minHeight": 480,
        "visible": false,
        "backgroundThrottling": "disabled",
        "contentProtected": true
      },
      {
        "label": "palette",
        "title": "WM Pass quick search",
        "url": "palette.html",
        "width": 560,
        "height": 380,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "backgroundThrottling": "disabled",
        "contentProtected": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": false
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/wasi-master/wm-pass/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4MjcxOUI2NkEzQjVEMzcKUldRM1hUdHF0aGtuaUR0WGg3WDZrVnVRVHhJTTE0S2R5SDJrb1ExVHdWdm5KcE5WaXo0OEFXbEQK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/wm-pass-host"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "copyright": "Copyright © 2026 Wasi Master. MIT License.",
    "category": "Utility",
    "shortDescription": "A password manager that stays on your devices",
    "longDescription": "WM Pass keeps your passwords, codes, cards and notes in an encrypted vault on your own devices, offline unless you ask otherwise.",
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
