<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by Tauri into the app's own Info.plist. wmpass:// is how a widget click reaches the app;
     src/widgets.rs reads only wmpass://widget/... links and ignores the rest. -->
<plist version="1.0">
<dict>
    <key>NSCameraUsageDescription</key>
    <string>WM Pass reads QR codes with the camera: one-time code setups, pairing codes and a new device's code. Frames never leave this computer.</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>WM Pass widget links</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>wmpass</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
