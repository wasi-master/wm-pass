{
  "name": "wm-pass-web",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "wasm": "sh scripts/build-wasm.sh",
    "assets": "sh scripts/copy-assets.sh",
    "dev": "npm run assets && vite --config ui/dev/vite.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "desktop:dev": "npm run assets && vite --config desktop/vite.config.ts",
    "desktop:build": "npm run assets && vite build --config desktop/vite.config.ts",
    "extension:build": "npm run wasm && npm run assets && vite build --config extension/vite.config.ts && sh extension/finish.sh"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/api": "2.12.4",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
