{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["svelte", "vite/client"],
    "paths": { "$ui/*": ["./ui/src/*"], "$help": ["./help/index.ts"], "$help/*": ["./help/*"] }
  },
  "include": ["help/**/*", "ui/src/**/*", "ui/dev/main.ts", "desktop/src/**/*", "extension/src/**/*", "web/src/**/*"]
}
