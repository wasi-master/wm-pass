---
// An app's mark, from the Simple Icons drawings the apps already carry in data/brands. Apps
// Simple Icons has no mark for get their initials on their own colour.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  name: string;
  /** Simple Icons slug, when it has the app. */
  slug?: string;
  /** Hex colour without the #, for apps without a slug. */
  color?: string;
  size?: number;
}

const { name, slug, size = 40 } = Astro.props;
// Builds run in docs/, beside the repository's data/.
const brands = join(process.cwd(), '..', 'data', 'brands');

function row(file: string, key: string): string[] | undefined {
  return readFileSync(join(brands, file), 'utf8')
    .split('\n')
    .map((line) => line.split('\t'))
    .find((cells) => cells[0] === key);
}

const path = slug ? row(`brand-paths/${slug[0]}.tsv`, slug)?.[1] : undefined;
const color = Astro.props.color ?? (slug ? row('brands.tsv', slug)?.[2] : undefined) ?? '6B7280';
const [r, g, b] = [0, 2, 4].map((at) => parseInt(color.slice(at, at + 2), 16));
const ink = 0.299 * r + 0.587 * g + 0.114 * b > 170 ? '#111' : '#fff';
const initials = name.replace(/[^A-Za-z0-9 ]/g, '').split(' ').map((word) => word[0]).join('').slice(0, 2);
---

<span class="logo" style={`--size:${size}px;--tile:#${color};--ink:${ink}`} aria-hidden="true">
  {path ? <svg viewBox="0 0 24 24"><path d={path} /></svg> : <span>{initials}</span>}
</span>

<style>
  .logo {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: calc(var(--size) * 0.26);
    background: var(--tile);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }
  svg {
    width: 58%;
    height: 58%;
    fill: currentColor;
  }
  span span {
    font-weight: 700;
    font-size: calc(var(--size) * 0.4);
    line-height: 1;
  }
</style>
